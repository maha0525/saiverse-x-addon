{
    "name": "x_read_timeline",
    "display_name": {
        "ja": "Xタイムライン閲覧",
        "en": "Browse X Timeline"
    },
    "description": {
        "ja": "X（Twitter）のホームタイムラインを取得し、記憶に保存する。",
        "en": "Fetch home timeline on X (Twitter) and save to memory."
    },
    "input_schema": [
        {
            "name": "input",
            "description": "タイムラインを確認する理由や関心"
        }
    ],
    "router_callable": true,
    "dev_only": true,
    "required_credentials": ["x"],
    "nodes": [
        {
            "id": "fetch",
            "type": "tool",
            "action": "x_read_timeline",
            "args_input": {
                "max_results": 10
            },
            "next": "record"
        },
        {
            "id": "record",
            "type": "memorize",
            "action": "Xタイムライン取得結果:\n{last}",
            "role": "system",
            "tags": ["x_timeline", "playbook_result"],
            "next": null
        }
    ],
    "start_node": "fetch"
}
